{
  "name": "RAJA AI Chart Scanner V9.3 Pattern Only",
  "short_name": "RAJA Scanner V9.3",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#090512",
  "theme_color": "#0b0619",
  "description": "RAJA AI pattern-only chart scanner with Focus Guard, mobile Scan Gate, candle-pattern signals, pair-labelled results and persistent license support.",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/static/raja-ai-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/raja-ai-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/raja-ai-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "chart",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      ]
    }
  }
}
